# ==============================================================================
# ChemLearn XII — Environment Variables Template
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk konfigurasi lokal Anda:
#   Windows (PowerShell): Copy-Item .env.example .env.local
#   Linux / macOS:        cp .env.example .env.local
#
# Catatan: Variabel yang diekspos ke sisi klien (browser) di Vite WAJIB diawali
# dengan awalan prefix `VITE_`.
# ==============================================================================

# --- IDENTITAS APLIKASI ---
VITE_APP_TITLE="ChemLearn XII - Media Pembelajaran Kimia SMA"
VITE_APP_SHORT_NAME="ChemLearn XII"
VITE_APP_DESCRIPTION="Platform Pembelajaran Kimia SMA/MA Kelas XII: Larutan Elektrolit & Nonelektrolit"
VITE_APP_VERSION="1.0.0"

# --- LINGKUNGAN PENGEMBANGAN ---
# Nilai: development | production | test
VITE_APP_ENV="development"
VITE_APP_PORT=5173

# --- AUTENTIKASI & DATABASE (OPSIONAL) ---
# Sistem login bersifat opsional. Jika true, menggunakan mock database di browser (localStorage).
VITE_ENABLE_MOCK_AUTH="true"

# Google OAuth Client ID (opsional, jika ingin mengaktifkan Google Sign-In asli)
# Contoh: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=""

# Backend API Base URL (opsional, jika di kemudian hari dihubungkan ke server database backend/cloud)
# Contoh: http://localhost:5000/api atau https://api.chemlearn.id/v1
VITE_API_BASE_URL=""

# --- PENGATURAN KUIS & PENILAIAN ---
VITE_KKM_SCORE=75
VITE_DEFAULT_GURU_PIN="8888"
VITE_DEFAULT_SISWA_PIN="1234"
